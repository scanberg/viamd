[Script]
Text="""VO = sdf(resname("SOL"), element('O') in resname("SOL"), 8.0);
VH = sdf(resname("SOL"), element('H') in resname("SOL"), 8.0)/2;
d = distance(protein, resname("AIN"));
nb = count(resname("SOL") and within(4.0,resname("AIN")),'residue');
dih = dihedral(1198, 1207, 1208, 1209);
drift = rmsd(backbone());
coul = attr("edr/coul_sr_protein_ain");
rama = ramachandran(protein);
rama_loop = ramachandran(residue(100:140));
shape = shapespace(resname("AIN"));
shape_res = shapespace(residue(100:130));
"""

