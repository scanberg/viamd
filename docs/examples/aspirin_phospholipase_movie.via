[Script]
Text="""
sel1 = residue({5,9,18,21:23,27:31,44,47:48,63,100});
d = distance(sel1,resname("AIN"));
nb = count(resname("SOL") and within(4.0,resname("AIN")),'residue');
dih = dihedral(1198, 1207, 1208, 1209);

c_pr_ain = attr("edr/coul_sr_protein_ain");
lj_pr_ain = attr("edr/lj_sr_protein_ain");
E_prot_asp = c_pr_ain + lj_pr_ain ;

c_ain_sol = attr("edr/coul_sr_ain_sol");
lj_ain_sol = attr("edr/lj_sr_ain_sol");
E_ain_water = c_ain_sol + lj_ain_sol;
"""

