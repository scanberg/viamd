# An angle per frame: v1 gives radians, VIAL degrees; the units make them comparable
# data: 1ALA-560ns.pdb
=== v1
a = angle(name("N") in residue(5), name("CA") in residue(5), name("C") in residue(5));
=== vial
r = residue[4]
a = angle(r and particle(name='N'), r and particle(name='CA'), r and particle(name='C'))
