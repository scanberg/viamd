# Between the centres of the rings of tryptophan's indole per frame
# data: tryptophan-md.gro tryptophan-md.trr
=== v1
d = distance(com(ring(size=6, kind="aromatic") in resname("TRP")), com(ring(size=5) in resname("TRP")));
=== vial
trp = particle(resname='TRP')
d = distance(particle(ring(kind='aromatic', size=6, scope=trp)).com, particle(ring(size=5, scope=trp)).com)
