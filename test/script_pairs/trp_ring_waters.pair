# Waters near the aromatic rings of tryptophan per frame, counted by residue
# data: tryptophan-md.gro tryptophan-md.trr
=== v1
nw = count(within(3.5, ring(kind="aromatic") in resname("TRP")) and water(), "residue");
=== vial
aro = particle(ring(kind='aromatic', scope=particle(resname='TRP')))
nw = len(residue(within(3.5, of=aro) and water))
